# Local development. GitHub Pages builds the site with its own github-pages gem
# (Jekyll 3.10), so keep templates compatible with both; see _config.yml.
source "https://rubygems.org"

gem "jekyll", "~> 4.4"

# Plugins (all on the GitHub Pages allowlist)
gem "jekyll-feed"
gem "jekyll-sitemap"

# Ruby 3.4+ no longer bundles these as default gems; Jekyll needs them.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"

# Dev server for `jekyll serve` on Ruby 3+
gem "webrick", "~> 1.8"
