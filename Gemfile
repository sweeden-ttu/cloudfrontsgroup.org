# Local development only. GitHub Pages does NOT run Jekyll for this site
# (see .nojekyll); these gems exist so `bundle exec jekyll serve` can
# build and preview the static site on your machine.
source "https://rubygems.org"

gem "jekyll", "~> 4.4"

# Ruby 3.4+ no longer bundles these as default gems; Jekyll needs them.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"

# Dev server for `jekyll serve` on Ruby 3+
gem "webrick", "~> 1.8"
